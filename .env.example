# OneBrain — secrets template.
# Copy to ~/.secrets/.env (chmod 600) and fill in real values.
# NOTHING in this file should ever be committed. The scripts read these at runtime;
# no token value is ever stored in the OneBrain repo itself.

# --- gbrain auth tokens (generate your own random strings) ---
# Admin bootstrap token: used by `gbrain serve` to mint/verify auth. Keep private.
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=

# Remote/client bearer token: what each AI agent (Claude, Codex, Grok, gateway)
# presents to the local MCP endpoint. Loopback-only, but still bearer-gated.
GBRAIN_REMOTE_TOKEN=

# Desktop/Cowork bridge token (optional): used by the Claude Desktop stdio->HTTP bridge.
GBRAIN_DESKTOP_TOKEN=

# --- paths ---
# Absolute path to your Obsidian vault (the single source of truth).
OBSIDIAN_VAULT_PATH=$HOME/Obsidian/YourVault

# Absolute path to your local gbrain checkout.
GBRAIN_REPO=$HOME/Code/gbrain

# IMPORTANT: do NOT set OPENAI_API_KEY here if you want 100% offline embeddings.
# OneBrain uses local Ollama (nomic-embed-text). The scripts actively unset
# OPENAI_API_KEY so nothing silently falls back to a paid cloud embedding API.
