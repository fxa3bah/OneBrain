<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.gbrain.lessons</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/faadi/.gbrain/bin/gbrain-lessons.sh</string>
    </array>

    <!-- 03:05, ahead of enrichment at 03:17 and the doctor at 07:40, so the
         heartbeat is fresh by the time the watchdog reads it. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/faadi/.gbrain/logs/lessons.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/faadi/.gbrain/logs/lessons.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
