# OneBrain — never commit secrets, local state, or personal data
.env
.env.local
*.local
secrets/
.secrets/

# Runtime / local state (machine-specific)
logs/
*.log
*.lock.d/
last-synced-commit
enrichment-starts.log
ENRICHMENT_DISABLED
ENRICHMENT_TIER

# The vault itself is YOUR private knowledge — never vendor it here
vault/
Obsidian/

# gbrain checkout / DB (rebuildable index, not source)
gbrain/
*.pglite
pgdata/

# OS noise
.DS_Store

# Per-agent local session memory. Machine-specific working notes, not project source.
# This repo is public: a session memory file here would publish whatever the agent
# happened to be doing. (Caught 2026-07-25 before the first one was written.)
.claude/
.codex/
.grok/
